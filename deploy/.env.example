# Скопируйте в файл .env в корне проекта на сервере: cp deploy/.env.example .env
# и заполните значения. Файл .env в git не попадает.

# Пароль базы данных. Сгенерируйте: openssl rand -hex 24
POSTGRES_PASSWORD=

# Адрес сайта. Без своего домена подойдёт бесплатный вида 1-2-3-4.sslip.io,
# где 1-2-3-4 — IP вашего сервера через дефисы. HTTPS настроится сам.
SITE_ADDRESS=

# 1 — показывать демо-аккаунты на странице входа (удобно жюри), 0 — скрыть
SHOW_DEMO_ACCOUNTS=1
