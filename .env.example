# Скопируйте в .env.local (локально его создаёт `npm run dev:local` автоматически).
# Реальные .env* в git не попадают.

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/dekanat

# Размер пула соединений на процесс (по умолчанию 10)
# DB_POOL_MAX=10

# Скрыть подсказку с демо-аккаунтами на странице входа
# SHOW_DEMO_ACCOUNTS=0
